{
	"$schema": "https://schema.tauri.app/config/2",
	"app": {
		"security": {
			"csp": null
		},
		"windows": [
			{
				"decorations": false,
				"height": 800,
				"minHeight": 400,
				"minWidth": 600,
				"title": "Madora",
				"transparent": false,
				"visible": false,
				"width": 1000
			}
		]
	},
	"build": {
		"beforeBuildCommand": "bun run build",
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:1420",
		"frontendDist": "../dist"
	},
	"bundle": {
		"active": true,
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"linux": {
			"appimage": {
				"bundleMediaFramework": false,
				"files": {}
			},
			"deb": {
				"desktopTemplate": "madora.desktop",
				"files": {}
			},
			"rpm": {
				"desktopTemplate": "madora.desktop",
				"epoch": 0,
				"files": {},
				"release": "1"
			}
		},
		"publisher": "ichiyo",
		"targets": "all"
	},
	"identifier": "in.ichiyo.madora",
	"productName": "Madora",
	"version": "0.2.0"
}

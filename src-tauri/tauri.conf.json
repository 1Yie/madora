{
	"$schema": "https://schema.tauri.app/config/2",
	"app": {
		"security": {
			"csp": {
				"base-uri": "'self'",
				"connect-src": "ipc: http://ipc.localhost https://api.github.com",
				"default-src": "'self' customprotocol: asset:",
				"font-src": "'self' data:",
				"form-action": "'none'",
				"frame-src": "'none'",
				"img-src": "'self' asset: data: blob: madora: http://madora.localhost https:",
				"media-src": "'self' madora: http://madora.localhost",
				"object-src": "'none'",
				"script-src": "'self' 'wasm-unsafe-eval'",
				"style-src": "'self' 'unsafe-inline'"
			},
			"devCsp": {
				"base-uri": "'self'",
				"connect-src": "ipc: http://ipc.localhost ws://localhost:1420 ws://localhost:1421 http://localhost:1420 https://api.github.com",
				"default-src": "'self' customprotocol: asset:",
				"font-src": "'self' data:",
				"img-src": "'self' asset: data: blob: madora: http://madora.localhost https:",
				"media-src": "'self' madora: http://madora.localhost",
				"object-src": "'none'",
				"script-src": "'self' 'unsafe-inline' 'wasm-unsafe-eval'",
				"style-src": "'self' 'unsafe-inline'"
			}
		},
		"windows": [
			{
				"decorations": false,
				"height": 800,
				"minHeight": 600,
				"minWidth": 900,
				"title": "Madora",
				"transparent": false,
				"visible": false,
				"width": 1000
			}
		]
	},
	"build": {
		"beforeBuildCommand": "bun run build",
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:1420",
		"frontendDist": "../dist"
	},
	"bundle": {
		"active": true,
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"linux": {
			"deb": {
				"desktopTemplate": "madora.desktop",
				"files": {}
			},
			"rpm": {
				"desktopTemplate": "madora.desktop",
				"epoch": 0,
				"files": {},
				"release": "1"
			}
		},
		"publisher": "ichiyo",
		"targets": ["app", "dmg", "deb", "rpm", "msi", "nsis"]
	},
	"identifier": "in.ichiyo.madora",
	"productName": "Madora",
	"version": "0.4.0"
}

{
	"expo": {
		"android": {
			"adaptiveIcon": {
				"backgroundColor": "#E6F4FE",
				"backgroundImage": "./assets/images/android-icon-background.png",
				"foregroundImage": "./assets/images/android-icon-foreground.png",
				"monochromeImage": "./assets/images/android-icon-monochrome.png"
			},
			"package": "im.ingstar.madora",
			"permissions": [
				"android.permission.CAMERA",
				"android.permission.RECORD_AUDIO"
			],
			"predictiveBackGestureEnabled": false
		},
		"experiments": {
			"reactCompiler": true,
			"typedRoutes": true
		},
		"icon": "./assets/images/icon.png",
		"ios": {
			"bundleIdentifier": "im.ingstar.madora",
			"icon": "./assets/expo.icon",
			"infoPlist": {
				"NSCameraUsageDescription": "Madora uses the camera to scan the pairing QR code shown by the desktop app."
			}
		},
		"name": "app",
		"orientation": "portrait",
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"backgroundColor": "#208AEF",
					"image": "./assets/images/splash-icon.png",
					"imageWidth": 76
				}
			],
			"expo-sqlite",
			[
				"expo-camera",
				{
					"cameraPermission": "Madora uses the camera to scan the pairing QR code shown by the desktop app."
				}
			],
			"@actualwave/react-native-codeditor",
			"expo-secure-store"
		],
		"scheme": "app",
		"slug": "app",
		"userInterfaceStyle": "automatic",
		"version": "1.0.0",
		"web": {
			"favicon": "./assets/images/favicon.png",
			"output": "static"
		}
	}
}
